# Copy to .env.local and adjust. Every variable is optional.

# Base URL of the Dijkstra Web student platform (login / onboarding / dashboard links)
NEXT_PUBLIC_DIJKSTRA_PLATFORM_URL=https://platform.dijkstra.org.in

# Canonical URL of this site (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://dijkstra.org.in

# ---------------------------------------------------------------------------
# Team explorer (home page "Current members" + /team). All optional.
# Without a token the site shows the bundled team snapshot (lib/teams/seed.ts).
# ---------------------------------------------------------------------------

# Server-only token with `read:org` (classic PAT) or "Members: read" (fine-grained).
# GITHUB_TEAMS_TOKEN takes precedence over GITHUB_TOKEN.
GITHUB_TEAMS_TOKEN=

# Organisation to read teams from (default: Dijkstra-Edu)
GITHUB_ORG=Dijkstra-Edu

# Only show people who made their organisation membership public on GitHub.
# Counts still include everyone. (default: false)
TEAMS_PUBLIC_MEMBERS_ONLY=false

# How long team data is cached, in seconds (default: 3600)
TEAMS_REVALIDATE_SECONDS=3600

# GitHub API base URL â€” only change for GitHub Enterprise Server or tests
# GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Contact form (/contact and the home page). Optional.
# A Discord channel webhook (https://discord.com/api/webhooks/â€¦) or any URL that
# accepts a JSON POST. Without it the form explains how to reach us instead.
# ---------------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
